# ============================================================
# DataPath — переменные окружения (пример)
# Скопируйте в .env и измените при необходимости:
#   cp .env.example .env
#
# Backend читает переменные с префиксом DATAPATH_.
# По умолчанию backend работает без .env (все значения ниже — дефолты).
# ============================================================

# --- Backend ---

# Окружение: development | test | production
DATAPATH_ENVIRONMENT=development

# Хост и порт uvicorn
DATAPATH_HOST=0.0.0.0
DATAPATH_PORT=8000

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
DATAPATH_LOG_LEVEL=INFO

# Корень проекта. Если не задан — определяется автоматически.
# В Docker Compose устанавливается в /app.
# DATAPATH_PROJECT_ROOT=

# SQLite. Относительный путь резолвится от корня проекта.
DATAPATH_DATABASE_URL=sqlite:///./data/datapath.db

# Относительный путь к Obsidian vault (канонический источник контента).
DATAPATH_VAULT_PATH=content/vault

# CORS: разделённые запятыми origins для локального frontend (Vite dev).
DATAPATH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Frontend (Vite dev server) ---

# Куда Vite проксирует /api во время локальной разработки.
# VITE_PROXY_TARGET=http://localhost:8000
